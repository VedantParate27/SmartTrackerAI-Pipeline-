[TEMPLATE]
# Generate a production value with: python -c "import secrets; print(secrets.token_hex(32))"
SMARTTRACKER_SECRET_KEY=replace-with-a-long-random-secret

# Comma-separated frontend origins allowed to call FastAPI.
SMARTTRACKER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. The default is backend/smarttracker.db.
# SMARTTRACKER_DATABASE_URL=sqlite:///C:/absolute/path/to/smarttracker.db

# ---------------------------------------------------------------------------
# Waste-AI integration (subprocess adapter: backend/ai_client.py + ai_worker.py)
# ---------------------------------------------------------------------------
# off = never invoke the AI (manual triage cohort) | assist = invoke on demand.
# No production/auto mode exists by design.
WASTE_AI_MODE=assist

# Absolute path to the AI source directory (the folder that CONTAINS
# waste_pipeline.py / cleanup_verifier.py / config.py / .env).
# Example: WASTE_AI_SRC=C:/path/to/repo/ai/src
WASTE_AI_SRC=

# Hard timeout for the AI subprocess, seconds.
WASTE_AI_TIMEOUT_S=120

# Radius (metres) used to count prior reports at the same location.
# Default 50 m; capped at 1000 m. Stored per-analysis in WasteAIResult.radius_m.
WASTE_RECURRENCE_RADIUS_M=50
